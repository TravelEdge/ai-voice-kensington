#### GTMI_TAC_DEMO ######
# Twilio Account Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Conversation Configuration (from TAC Setup Wizard)
TWILIO_CONVERSATION_CONFIGURATION_ID=

# Phone Number (E.164 format)
TWILIO_PHONE_NUMBER=
TWILIO_RCS_SENDER_ID=

# HANDOFF TaskRouter Workflow SIDs — one per prompt/intent that hands off to a
# workflow. HANDOFF_NEW_LEAD_WORKFLOW_SID should be a workflow with a known-
# agent routing rule that matches task.triage_target_friendly_name to the worker
# friendly name. HANDOFF_IN_DESTINATION_WORKFLOW_SID routes IN_DESTINATION
# handoffs by TaskRouter rules; no specific agent is targeted.
HANDOFF_NEW_LEAD_WORKFLOW_SID=
HANDOFF_IN_DESTINATION_WORKFLOW_SID=
HANDOFF_EXISTING_QUOTE_OR_TRIP_WORKFLOW_SID=
HANDOFF_GENERAL_ENQUIRY_WORKFLOW_SID=

# Emergency-fallback workflow used when Claude is unreachable (two consecutive
# failures). The call is handed off to a live agent who can route it manually
# instead of leaving the caller stuck on a broken bot.
HANDOFF_LIVE_ANSWER_WORKFLOW_SID=
# TTS-friendly message spoken before the emergency fallback handoff.
FALLBACK_LIVE_ANSWER_MESSAGE=I'm sorry, I'm having difficulty reaching critical services. I'm going to connect you to a live agent who will direct you to the correct specialist.

# Server Configuration — set to your ngrok/production domain (no protocol prefix)
TWILIO_VOICE_PUBLIC_DOMAIN=

# Default ConversationRelay TwiML options applied to every inbound voice call
DEFAULT_TWIML_OPTIONS_SPEECH_TIMEOUT=auto
DEFAULT_TWIML_OPTIONS_WELCOME_GREETING=Welcome to Kensington Tours.  You have reached Live Answer - how can i help you today?
DEFAULT_TWIML_OPTIONS_VOICE=lxYfHSkYm1EzQzGhdbfc
# Barge-in controls:
#   INTERRUPTIBLE: any | speech | none (recommended: speech — voice-only, ignores accidental DTMF)
#   INTERRUPT_SENSITIVITY: high | medium | low (Twilio default is high; medium is more forgiving of background noise)
#   WELCOME_GREETING_INTERRUPTIBLE: any | speech | none (recommended: any so callers can jump in on the greeting)
DEFAULT_TWIML_OPTIONS_INTERRUPTIBLE=speech
DEFAULT_TWIML_OPTIONS_INTERRUPT_SENSITIVITY=medium
DEFAULT_TWIML_OPTIONS_WELCOME_GREETING_INTERRUPTIBLE=any

# ConversationRelay TwiML options used when a transfer fails and the call is
# returned to the AI agent for a callback (enqueue-with-takeback flow)
RETURN_TO_AGENT_TWIML_OPTIONS_SPEECH_TIMEOUT=auto
RETURN_TO_AGENT_TWIML_OPTIONS_WELCOME_GREETING=I apologize, it appears the agent i tried to transfer you to is not available, can i ask you a few more questions so i can pass along your infromation and have them call you back?
RETURN_TO_AGENT_TWIML_OPTIONS_VOICE=lxYfHSkYm1EzQzGhdbfc
RETURN_TO_AGENT_TWIML_OPTIONS_INTERRUPTIBLE=speech
RETURN_TO_AGENT_TWIML_OPTIONS_INTERRUPT_SENSITIVITY=medium
RETURN_TO_AGENT_TWIML_OPTIONS_WELCOME_GREETING_INTERRUPTIBLE=any

# OPTIONAL: Conversation Memory
TWILIO_MEMORY_STORE_ID=
TWILIO_TRAIT_GROUPS=NewLead


# OPTIONAL: Knowledge Base
TWILIO_KNOWLEDGE_BASE_ID=
TWILIO_KNOWLEDGE_BASE_PROMPT=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Agent persona (optional override)
AI_AGENT_NAME=KensingtonTours LiveAnswer

USE_API_STUBS=true

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL controls the pino level threshold: fatal | error | warn | info |
# debug | trace. Default "info". Set to "debug" to unhide the full-conversation
# transcript dump on teardown and any future breadcrumbs added at debug level.
LOG_LEVEL=info
# LOG_DISABLED_FLAGS is a comma-separated list of log CATEGORIES to suppress.
# Errors are never gated behind these — you always see them. Leave blank to
# get the full stream. Available flags:
#   TOOLS_CALL              per-tool-invocation log with input
#   TOOLS_RESULT            per-tool-result log with the full parsed result + duration
#   CLAUDE_API              per-Claude-attempt log with model + requestTime
#   CLAUDE_API_PAYLOAD      MODIFIER — when enabled (i.e. not in this list),
#                           CLAUDE_API and AGENT_RESPONSE include the full
#                           request payload (model, max_tokens, system,
#                           messages, tools). When disabled, only
#                           { model, lastMessage } is included.
#   CUSTOMER_INPUT          the "Customer input" log at handleMessage entry
#   AGENT_RESPONSE          the aggregate response log with
#                           customerToAgentResponseTime and claudeApiResponseTimes
#   INTERRUPT               barge-in event log
#   INTENT_CHANGE           IntentMap setAndLog transitions
#   CONVERSATION_LIFECYCLE  conversation-ended + full-transcript debug dump
#   HANDOFF_LIFECYCLE       end_call scheduling markers
#   FALLBACK                Claude retry warn + double-failure error path
# Example: suppress full Claude payloads (they're big) but keep the timing:
#   LOG_DISABLED_FLAGS=CLAUDE_API_PAYLOAD
LOG_DISABLED_FLAGS=CLAUDE_API_PAYLOAD

# When true AND USE_API_STUBS is false, write each live API response to a
# timestamped file under src/stubs/<api>_log/ for later inspection / seeding of
# stubs. Currently wired into get_lead_assignment_queue only.
LOG_API_RESPONSES=

LEADQUEUE_AUTH0_DOMAIN=auth.uat.triparcservices.com
LEADQUEUE_CLIENT_ID=
LEADQUEUE_CLIENT_SECRET=
LEADQUEUE_AUDIENCE=https://trip-arc.com/tap

TMT_LEGACY_BASE_URL=
TMT_LEGACY_AUTH_URL=
TMT_LEGACY_USERNAME=
TMT_LEGACY_PASSWORD=

TMT_PROFILE_BASE_URL=
TMT_PROFILE_AUTH_URL=
TMT_PROFILE_CLIENT_ID=
TMT_PROFILE_CLIENT_SECRET=

EMAIL_PROVIDER=twilio

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_TO_EMAIL=

TWILIO_EMAIL_FROM_ADDRESS=
TWILIO_EMAIL_FROM_NAME=
TWILIO_EMAIL_TO_ADDRESS=