#### GTMI_TAC_DEMO ######
# Twilio Account Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# Conversation Configuration (from TAC Setup Wizard)
TWILIO_CONVERSATION_CONFIGURATION_ID=

# Phone Number (E.164 format)
TWILIO_PHONE_NUMBER=
TWILIO_RCS_SENDER_ID=

# HANDOFF TaskRouter Workflow SID - should be a workflow
# with known agent routing rule that will match a task attribute
# task.triage_target_friendly_name to the worker friendly name
HANDOFF_WORKFLOW_SID=

# Server Configuration — set to your ngrok/production domain (no protocol prefix)
TWILIO_VOICE_PUBLIC_DOMAIN=

# OPTIONAL: Conversation Memory
TWILIO_MEMORY_STORE_ID=
TWILIO_TRAIT_GROUPS=NewLead


# OPTIONAL: Knowledge Base
TWILIO_KNOWLEDGE_BASE_ID=
TWILIO_KNOWLEDGE_BASE_PROMPT=

# Anthropic / Claude
ANTHROPIC_API_KEY=

# Agent persona (optional override)
AI_AGENT_NAME=AI Support

# TaskRouter workflow used by the IN_DESTINATION prompt's transfer_to_workflow tool
IN_DESTINATION_WORKFLOW_SID=


USE_API_STUBS=true

LEADQUEUE_AUTH0_DOMAIN=auth.uat.triparcservices.com
LEADQUEUE_CLIENT_ID=
LEADQUEUE_CLIENT_SECRET=
LEADQUEUE_AUDIENCE=https://trip-arc.com/tap

TMT_LEGACY_BASE_URL=
TMT_LEGACY_AUTH_URL=
TMT_LEGACY_USERNAME=
TMT_LEGACY_PASSWORD=

TMT_PROFILE_BASE_URL=
TMT_PROFILE_AUTH_URL=
TMT_PROFILE_CLIENT_ID=
TMT_PROFILE_CLIENT_SECRET=