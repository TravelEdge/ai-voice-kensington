    "version": "0.2.0",
    "configurations": [
    {
      "name": "Debug TSX App",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "watch" 
      ],
      "args": [
        "${workspaceFolder}/src/index.ts"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    }
  ]
}