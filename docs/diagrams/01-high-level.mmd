    classDef internal fill:#dbeafe,stroke:#2563eb,stroke-width:1px,color:#000
    classDef llm fill:#f3e8ff,stroke:#9333ea,stroke-width:1px,color:#000
    class Caller caller
    class Studio,TwiML,Flex external
    class TAC internal
    class Claude,Tools llm
